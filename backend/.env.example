# ── M.NationWorld 后端环境变量模板 ──
# 复制为 .env 并填写；.env 永不提交（gitignore 已排除）。
# 启动方式：node --env-file-if-exists=.env src/server.js（npm start）

# ── 服务 ──
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/mn.sqlite
NODE_ENV=development

# ── 管理员 ──
# 首个管理员邮箱（seed-admin 脚本据此升级 role=admin）
ADMIN_EMAIL=

# ── 邮件 SMTP（nodemailer）──
# 首选腾讯云 SES（国际站可用性上线前验证）；不可用换 Mailgun，只改这里。
MAIL_FROM=M.NationWorld <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# ── DeepSeek（文字审核 + AI 客服；密钥只在后端）──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── 腾讯云（图像审核 IMS；备选 AWS Rekognition / 阿里云国际站，换配置级改动）──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_IMS_REGION=ap-singapore

# ── 月度预算上限（元，管理员可在后台调整）──
BUDGET_MODERATION_TEXT=30
BUDGET_CHAT=20
BUDGET_MODERATION_IMAGE=10
BUDGET_TOTAL=60

# ── 前后端分离（前端独立托管 COS/CDN，API 独立子域）──
# 会话 cookie 放大到根域，前端子域才能携带登录态；本地同域开发留空。
# 例：COOKIE_DOMAIN=mn.world
COOKIE_DOMAIN=
# CORS 白名单（逗号分隔多个 Origin，必须是完整 scheme+域名，无路径）。
# 例：FRONTEND_ORIGIN=https://mn.world,https://www.mn.world
FRONTEND_ORIGIN=
