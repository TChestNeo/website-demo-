{
  "name": "mn-backend",
  "version": "0.1.0",
  "private": true,
  "description": "M.NationWorld 后端（node:http + SQLite，零框架）",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
